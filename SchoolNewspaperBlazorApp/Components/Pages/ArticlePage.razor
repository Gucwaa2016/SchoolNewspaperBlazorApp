@page "/article/{Id:int}"
@inject IFileService FileService
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service


@if (article != null)
{
    <article class="article-page">

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }

        <h1 class="article-page__title">@article.Title</h1>


        <div class="article-page__content">
            @article.Text
        </div>

        <div class="article-page__meta">
            <span class="article-page__author">@article.Author</span>
        </div>
        <h3 class="gallery-title">Galeria zdjęć</h3>

        <div class="gallery">
            @foreach (var image in galleryImages)
            {
                <img src="@image"
                     alt="Zdjęcie artykułu"
                     @onclick="() => OpenPreview(image)" />
            }
        </div>

        
        @if (!string.IsNullOrEmpty(selectedImage))
        {
            <div class="image-preview-overlay" @onclick="ClosePreview">
                <div class="image-preview-window"
                     @onclick:stopPropagation="true">

                    <div class="image-preview-header">
                        <div class="image-preview-heading">
                            <span class="image-preview-label">GALERIA ZDJĘĆ</span>
                            <span class="image-preview-subtitle">Podgląd fotografii</span>
                        </div>

                        <button type="button"
                                class="image-preview-close"
                                @onclick="ClosePreview"
                                aria-label="Zamknij podgląd">
                            &times;
                        </button>
                    </div>

                    <div class="image-preview-content">
                        <img src="@selectedImage"
                             alt="Podgląd zdjęcia"
                             class="image-preview-large" />
                    </div>

                    <div class="image-preview-footer">
                        <span>Szkolna gazeta</span>
                        <span>Podgląd zdjęcia</span>
                    </div>
                </div>
            </div>
        }
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;
    [Parameter]
    public int ArticleId { get; set; }

    private List<string> images = new();

    protected override async Task OnParametersSetAsync()
    {
        images = await FileService.GetImagesByArticleIdAsync(ArticleId);
    }
    private List<string> galleryImages = new();
    private string? selectedImage;

    private void OpenPreview(string image)
    {
        selectedImage = image;
    }

    private void ClosePreview()
    {
        selectedImage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        article = await articleService.GetArticleByIdAsync(Id);

        if (article != null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(article.MainImageId);

            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }

            galleryImages = await fileService.GetImagesByArticleIdAsync(Id);
        }
    }
}